# Intelligence layer: auto | ollama | openai | heuristic
LLM_PROVIDER=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Any OpenAI-compatible endpoint (OpenAI, Groq, Together, vLLM, LM Studio...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Tickets labelled directly by the LLM; the rest are labelled by k-NN propagation
LLM_TICKET_BUDGET=240
LLM_BATCH_SIZE=20
# Embeddings: auto | sentence-transformers | tfidf
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Blend weight of the SaaS theme seed-lexicon into embeddings (blank = auto)
THEME_SEED_WEIGHT=
# Data on startup: synthetic | sample | /path/to/csv/folder
DATA_SOURCE=synthetic
SYNTHETIC_SEED=42
